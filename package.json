{
    "name": "@liquicode/jsonstor",
    "version": "0.1.0",
    "description": "A centralized MongoDB-style interface to work with a variety of database products and platforms.",
    "license": "MIT",
    "homepage": "http://jsonstor.liquicode.com",
    "repository": {
        "type": "git",
        "url": "https://github.com/liquicode/jsonstor"
    },
    "authors": [
        {
            "name": "Andre' G. Bowlin",
            "email": "agbowlin@gmail.com",
            "homepage": "http://liquicode.com"
        }
    ],
    "main": "src/jsonstor.js",
    "types": "./types/jsonstor.d.ts",
    "exports": {
        ".": {
            "types": "./types/jsonstor.d.ts",
            "browser": "./dist/jsonstor.min.js",
            "require": "./src/jsonstor.js",
            "default": "./src/jsonstor.js"
        },
        "./dist/*": "./dist/*",
        "./package.json": "./package.json"
    },
    "files": [
        "src",
        "dist",
        "types",
        "license.md",
        "readme.md",
        "history.md"
    ],
    "scripts": {
        "run webpack": "npx @liquicode/devops --tasks .\\build\\build.tasks.js run_webpack",
        "publish version": "npx @liquicode/devops --tasks .\\build\\build.tasks.js publish_version",
        "start new version": "npx @liquicode/devops --tasks .\\build\\build.tasks.js start_new_version"
    },
    "keywords": [
        "memory db",
        "file db",
        "mongo db",
        "mongo query",
        "query",
        "update",
        "project",
        "qbe",
        "$eq",
        "$and",
        "object",
        "compare"
    ],
    "devDependencies": {
        "@liquicode/devops": "^0.1.0",
        "webpack": "^5.90.3",
        "webpack-cli": "^5.1.4",
        "webpack-node-externals": "^3.0.0"
    },
    "dependencies": {
        "@liquicode/jsongin": "^0.1.0",
        "lockfile": "^1.0.4",
        "uuid": "^9.0.1"
    }
}
